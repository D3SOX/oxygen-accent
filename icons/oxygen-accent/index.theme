[Icon Theme]
Name=Oxygen Accent
Comment=Oxygen folders and interface icons that follow the system accent color
DisplayDepth=32
Inherits=oxygen,breeze,hicolor
Example=folder
FollowsColorScheme=true
LinkOverlay=link
LockOverlay=lockoverlay
ShareOverlay=share
ZipOverlay=zip
DesktopDefault=48
DesktopSizes=16,22,32,48,64,128,256
ToolbarDefault=22
ToolbarSizes=16,22,32,48
MainToolbarDefault=22
MainToolbarSizes=16,22,32,48
SmallDefault=16
SmallSizes=16,22,32,48
PanelDefault=48
PanelSizes=16,22,32,48,64,128,256
DialogDefault=32
DialogSizes=16,22,32,48,64,128,256
Directories=base/16x16/actions,base/16x16/apps,base/16x16/mimetypes,base/16x16/places,base/16x16/status,base/22x22/actions,base/22x22/apps,base/22x22/mimetypes,base/22x22/places,base/22x22/status,base/32x32/actions,base/32x32/apps,base/32x32/mimetypes,base/32x32/places,base/32x32/status,base/48x48/actions,base/48x48/apps,base/48x48/mimetypes,base/48x48/places,base/48x48/status,base/64x64/actions,base/64x64/apps,base/64x64/mimetypes,base/64x64/places,base/128x128/actions,base/128x128/apps,base/128x128/mimetypes,base/128x128/places,base/128x128/status,base/256x256/actions,base/256x256/apps,base/256x256/mimetypes,base/256x256/places

